import Mathlib

namespace ConstantLlapoy.PaperA

/-- At a maximum coordinate, a convex weighted average can equal the maximum
only if every coordinate with strictly positive weight also attains that
maximum. This is the finite weighted-average propagation step used in the
ratio proof of uniqueness for a positive Perron eigenvector. -/
theorem weighted_average_at_max_forces_positive_weight_coordinates_equal
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (w t : ι → ℝ) (i : ι)
    (hw_nonneg : ∀ j, 0 ≤ w j)
    (hw_sum : ∑ j, w j = 1)
    (ht_max : ∀ j, t j ≤ t i)
    (ht_average : ∑ j, w j * t j = t i) :
    ∀ j, 0 < w j → t j = t i := by
  classical
  have hsum_zero : ∑ j, w j * (t i - t j) = 0 := by
    calc
      ∑ j, w j * (t i - t j)
          = (∑ j, w j) * t i - ∑ j, w j * t j := by
              simp_rw [mul_sub]
              rw [Finset.sum_sub_distrib, ← Finset.sum_mul]
      _ = 0 := by rw [hw_sum, ht_average]; ring
  have hterms_nonneg : ∀ j ∈ (Finset.univ : Finset ι),
      0 ≤ w j * (t i - t j) := by
    intro j hj
    exact mul_nonneg (hw_nonneg j) (sub_nonneg.mpr (ht_max j))
  have hterms_zero := (Finset.sum_eq_zero_iff_of_nonneg hterms_nonneg).mp hsum_zero
  intro j hj
  have hzero : w j * (t i - t j) = 0 :=
    hterms_zero j (Finset.mem_univ j)
  have hdiff : t i - t j = 0 :=
    (mul_eq_zero.mp hzero).resolve_left (ne_of_gt hj)
  linarith


/-- The positive-edge reachability relation generated by a directed support
relation. This is kept explicit so that the graph-connectivity hypothesis in
the Perron uniqueness argument is visible rather than hidden in a matrix API. -/
inductive PFReachable {ι : Type*} (R : ι → ι → Prop) : ι → ι → Prop
  | refl (i : ι) : PFReachable R i i
  | step {i j k : ι} : R i j → PFReachable R j k → PFReachable R i k

/-- Equality propagated along every edge is equality along every finite
positive-edge path. -/
theorem ratio_eq_of_pf_reachable
    {ι : Type*} {R : ι → ι → Prop} {t : ι → ℝ}
    {i j : ι} (hreach : PFReachable R i j)
    (hedge : ∀ a b, R a b → t a = t b) :
    t i = t j := by
  induction hreach with
  | refl a => rfl
  | step hab htail ih =>
      exact (hedge _ _ hab).trans ih

/-- If every pair of vertices is connected by positive-support reachability,
then a ratio that is constant across each positive edge is globally constant.
This is the graph-theoretic final step in the PF eigenspace uniqueness proof. -/
theorem ratio_globally_constant_of_pf_connected
    {ι : Type*} {R : ι → ι → Prop} {t : ι → ℝ}
    (hconnected : ∀ i j, PFReachable R i j)
    (hedge : ∀ a b, R a b → t a = t b) :
    ∀ i j, t i = t j := by
  intro i j
  exact ratio_eq_of_pf_reachable (hconnected i j) hedge


/-- A stochastic row whose harmonic value is maximal can place positive
weight only on coordinates with the same value. This packages the
weighted-average lemma in the transition-kernel form used by the Perron
ratio argument. -/
theorem harmonic_value_equal_on_positive_transition
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (w : ι → ℝ) (t : ι → ℝ)
    (i : ι)
    (hw_nonneg : ∀ j, 0 ≤ w j)
    (hw_sum : ∑ j, w j = 1)
    (ht_max : ∀ j, t j ≤ t i)
    (ht_harmonic : ∑ j, w j * t j = t i) :
    ∀ j, 0 < w j → t j = t i := by
  exact weighted_average_at_max_forces_positive_weight_coordinates_equal
    w t i hw_nonneg hw_sum ht_max ht_harmonic


/-- A globally maximal harmonic function on a finite stochastic support
graph is constant on every vertex reachable from the maximizing vertex.
This is the substantive propagation theorem used by the positive-eigenvector
ratio argument: stochastic rows are the normalized Perron transition kernel. -/
theorem harmonic_ratio_constant_on_pf_reachable
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (P : ι → ι → ℝ) (t : ι → ℝ) (i : ι)
    (hP_nonneg : ∀ a b, 0 ≤ P a b)
    (hP_sum : ∀ a, ∑ b, P a b = 1)
    (h_harmonic : ∀ a, ∑ b, P a b * t b = t a)
    (h_max : ∀ b, t b ≤ t i)
    (h_reachable : ∀ j, PFReachable (fun a b => 0 < P a b) i j) :
    ∀ j, t j = t i := by
  have h_step : ∀ a b, t a = t i → 0 < P a b → t b = t a := by
    intro a b ha hab
    have h_local_max : ∀ k, t k ≤ t a := by
      intro k
      rw [ha]
      exact h_max k
    have h_local :=
      weighted_average_at_max_forces_positive_weight_coordinates_equal
        (P a) t a (fun k => hP_nonneg a k) (hP_sum a)
        h_local_max (h_harmonic a)
    exact h_local b hab
  have h_path : ∀ {a b}, PFReachable (fun x y => 0 < P x y) a b →
      t a = t i → t b = t i := by
    intro a b hpath
    induction hpath with
    | refl a =>
        intro ha
        exact ha
    | step hab htail ih =>
        intro ha
        have hnext : t _ = t _ := h_step _ _ ha hab
        exact ih (hnext.trans ha)
  intro j
  exact h_path (h_reachable j) rfl


/-- On a finite nonempty state space, every real-valued harmonic function
for an irreducible finite stochastic kernel is constant. The finite maximum
is attained; the preceding propagation theorem then carries that maximum
along every positive-transition path. -/
theorem harmonic_function_constant_of_pf_connected
    {ι : Type*} [Fintype ι] [DecidableEq ι] [Nonempty ι]
    (P : ι → ι → ℝ) (t : ι → ℝ)
    (hP_nonneg : ∀ a b, 0 ≤ P a b)
    (hP_sum : ∀ a, ∑ b, P a b = 1)
    (h_harmonic : ∀ a, ∑ b, P a b * t b = t a)
    (h_connected : ∀ i j,
      PFReachable (fun a b => 0 < P a b) i j) :
    ∀ i j, t i = t j := by
  classical
  obtain ⟨i₀, hi₀, h_i₀_max⟩ :=
    Finset.exists_max_image (Finset.univ : Finset ι) t Finset.univ_nonempty
  have h_max : ∀ j, t j ≤ t i₀ := by
    intro j
    exact h_i₀_max j (Finset.mem_univ j)
  have h_constant : ∀ j, t j = t i₀ :=
    harmonic_ratio_constant_on_pf_reachable
      P t i₀ hP_nonneg hP_sum h_harmonic h_max
      (fun j => h_connected i₀ j)
  intro i j
  exact (h_constant i).trans (h_constant j).symm

end ConstantLlapoy.PaperA

namespace ConstantLlapoy.PaperA

/-- Normalize a nonnegative matrix by a strictly positive right eigenvector.
The resulting transition kernel is stochastic. This is the algebraic bridge
from a positive Perron eigenvector to the harmonic-ratio uniqueness argument. -/
theorem perron_transition_kernel_of_positive_eigenvector
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (A : ι → ι → ℝ) (v : ι → ℝ) (lambdaVal : ℝ)
    (hA_nonneg : ∀ i j, 0 ≤ A i j)
    (hv : ∀ i, 0 < v i)
    (hlambdaVal : 0 < lambdaVal)
    (hAv : ∀ i, ∑ j, A i j * v j = lambdaVal * v i) :
    let P : ι → ι → ℝ :=
      fun i j => (A i j * v j) / (lambdaVal * v i)
    (∀ i j, 0 ≤ P i j) ∧
    (∀ i, ∑ j, P i j = 1) := by
  dsimp
  constructor
  · intro i j
    apply div_nonneg
    · exact mul_nonneg (hA_nonneg i j) (le_of_lt (hv j))
    · exact le_of_lt (mul_pos hlambdaVal (hv i))
  · intro i
    have hden : 0 < lambdaVal * v i := mul_pos hlambdaVal (hv i)
    calc
      ∑ j, (A i j * v j) / (lambdaVal * v i)
          = (∑ j, A i j * v j) / (lambdaVal * v i) := by
              rw [Finset.sum_div]
      _ = 1 := by
          rw [hAv i]
          exact div_self (ne_of_gt hden)


/-- With the same normalization, any other eigenvector for the same positive
eigenvalue gives a harmonic coordinate ratio. Combined with irreducibility,
the finite harmonic-constancy theorem forces this ratio to be constant. -/
theorem perron_eigenvector_ratio_is_harmonic
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (A : ι → ι → ℝ) (v y : ι → ℝ) (lambdaVal : ℝ)
    (hv : ∀ i, 0 < v i)
    (hlambdaVal : 0 < lambdaVal)
    (hAv : ∀ i, ∑ j, A i j * v j = lambdaVal * v i)
    (hAy : ∀ i, ∑ j, A i j * y j = lambdaVal * y i) :
    let P : ι → ι → ℝ :=
      fun i j => (A i j * v j) / (lambdaVal * v i)
    let t : ι → ℝ := fun i => y i / v i
    ∀ i, ∑ j, P i j * t j = t i := by
  dsimp
  intro i
  have hden : lambdaVal * v i ≠ 0 := ne_of_gt (mul_pos hlambdaVal (hv i))
  have hv_ne : ∀ j, v j ≠ 0 := fun j => ne_of_gt (hv j)
  have hterm : ∀ j,
      ((A i j * v j) / (lambdaVal * v i)) * (y j / v j) =
        (A i j * y j) / (lambdaVal * v i) := by
    intro j
    field_simp [hv_ne j, hden]
    ring
  calc
    ∑ j, ((A i j * v j) / (lambdaVal * v i)) * (y j / v j)
        = ∑ j, (A i j * y j) / (lambdaVal * v i) := by
            apply Finset.sum_congr rfl
            intro j hj
            exact hterm j
    _ = (∑ j, A i j * y j) / (lambdaVal * v i) := by
          rw [Finset.sum_div]
    _ = y i / v i := by
          rw [hAy i]
          field_simp


end ConstantLlapoy.PaperA
