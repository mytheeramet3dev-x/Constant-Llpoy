import Mathlib

namespace ConstantLlapoy.PaperA

/-- At a maximum coordinate, a convex weighted average can equal the maximum
only if every coordinate with strictly positive weight also attains that
maximum. This is the finite weighted-average propagation step used in the
ratio proof of uniqueness for a positive Perron eigenvector. -/
theorem weighted_average_at_max_forces_positive_weight_coordinates_equal
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (w t : ι → ℝ) (i : ι)
    (hw_nonneg : ∀ j, 0 ≤ w j)
    (hw_sum : ∑ j, w j = 1)
    (ht_max : ∀ j, t j ≤ t i)
    (ht_average : ∑ j, w j * t j = t i) :
    ∀ j, 0 < w j → t j = t i := by
  classical
  have hsum_zero : ∑ j, w j * (t i - t j) = 0 := by
    calc
      ∑ j, w j * (t i - t j)
          = (∑ j, w j) * t i - ∑ j, w j * t j := by
              simp_rw [mul_sub]
              rw [Finset.sum_sub_distrib, ← Finset.sum_mul]
      _ = 0 := by rw [hw_sum, ht_average]; ring
  have hterms_nonneg : ∀ j ∈ (Finset.univ : Finset ι),
      0 ≤ w j * (t i - t j) := by
    intro j hj
    exact mul_nonneg (hw_nonneg j) (sub_nonneg.mpr (ht_max j))
  have hterms_zero := (Finset.sum_eq_zero_iff_of_nonneg hterms_nonneg).mp hsum_zero
  intro j hj
  have hzero : w j * (t i - t j) = 0 :=
    hterms_zero j (Finset.mem_univ j)
  have hdiff : t i - t j = 0 :=
    (mul_eq_zero.mp hzero).resolve_left (ne_of_gt hj)
  linarith


/-- The positive-edge reachability relation generated by a directed support
relation. This is kept explicit so that the graph-connectivity hypothesis in
the Perron uniqueness argument is visible rather than hidden in a matrix API. -/
inductive PFReachable {ι : Type*} (R : ι → ι → Prop) : ι → ι → Prop
  | refl (i : ι) : PFReachable R i i
  | step {i j k : ι} : R i j → PFReachable R j k → PFReachable R i k

/-- Equality propagated along every edge is equality along every finite
positive-edge path. -/
theorem ratio_eq_of_pf_reachable
    {ι : Type*} {R : ι → ι → Prop} {t : ι → ℝ}
    {i j : ι} (hreach : PFReachable R i j)
    (hedge : ∀ a b, R a b → t a = t b) :
    t i = t j := by
  induction hreach with
  | refl a => rfl
  | step hab htail ih =>
      exact (hedge _ _ hab).trans ih

/-- If every pair of vertices is connected by positive-support reachability,
then a ratio that is constant across each positive edge is globally constant.
This is the graph-theoretic final step in the PF eigenspace uniqueness proof. -/
theorem ratio_globally_constant_of_pf_connected
    {ι : Type*} {R : ι → ι → Prop} {t : ι → ℝ}
    (hconnected : ∀ i j, PFReachable R i j)
    (hedge : ∀ a b, R a b → t a = t b) :
    ∀ i j, t i = t j := by
  intro i j
  exact ratio_eq_of_pf_reachable (hconnected i j) hedge


/-- A stochastic row whose harmonic value is maximal can place positive
weight only on coordinates with the same value. This packages the
weighted-average lemma in the transition-kernel form used by the Perron
ratio argument. -/
theorem harmonic_value_equal_on_positive_transition
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (w : ι → ℝ) (t : ι → ℝ)
    (i : ι)
    (hw_nonneg : ∀ j, 0 ≤ w j)
    (hw_sum : ∑ j, w j = 1)
    (ht_max : ∀ j, t j ≤ t i)
    (ht_harmonic : ∑ j, w j * t j = t i) :
    ∀ j, 0 < w j → t j = t i := by
  exact weighted_average_at_max_forces_positive_weight_coordinates_equal
    w t i hw_nonneg hw_sum ht_max ht_harmonic


/-- A globally maximal harmonic function on a finite stochastic support
graph is constant on every vertex reachable from the maximizing vertex.
This is the substantive propagation theorem used by the positive-eigenvector
ratio argument: stochastic rows are the normalized Perron transition kernel. -/
theorem harmonic_ratio_constant_on_pf_reachable
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (P : ι → ι → ℝ) (t : ι → ℝ) (i : ι)
    (hP_nonneg : ∀ a b, 0 ≤ P a b)
    (hP_sum : ∀ a, ∑ b, P a b = 1)
    (h_harmonic : ∀ a, ∑ b, P a b * t b = t a)
    (h_max : ∀ b, t b ≤ t i)
    (h_reachable : ∀ j, PFReachable (fun a b => 0 < P a b) i j) :
    ∀ j, t j = t i := by
  have h_step : ∀ a b, t a = t i → 0 < P a b → t b = t a := by
    intro a b ha hab
    have h_local_max : ∀ k, t k ≤ t a := by
      intro k
      rw [ha]
      exact h_max k
    have h_local :=
      weighted_average_at_max_forces_positive_weight_coordinates_equal
        (P a) t a (fun k => hP_nonneg a k) (hP_sum a)
        h_local_max (h_harmonic a)
    exact h_local b hab
  have h_path : ∀ {a b}, PFReachable (fun x y => 0 < P x y) a b →
      t a = t i → t b = t i := by
    intro a b hpath
    induction hpath with
    | refl a =>
        intro ha
        exact ha
    | step hab htail ih =>
        intro ha
        have hnext : t _ = t _ := h_step _ _ ha hab
        exact ih (hnext.trans ha)
  intro j
  exact h_path (h_reachable j) rfl


/-- On a finite nonempty state space, every real-valued harmonic function
for an irreducible finite stochastic kernel is constant. The finite maximum
is attained; the preceding propagation theorem then carries that maximum
along every positive-transition path. -/
theorem harmonic_function_constant_of_pf_connected
    {ι : Type*} [Fintype ι] [DecidableEq ι] [Nonempty ι]
    (P : ι → ι → ℝ) (t : ι → ℝ)
    (hP_nonneg : ∀ a b, 0 ≤ P a b)
    (hP_sum : ∀ a, ∑ b, P a b = 1)
    (h_harmonic : ∀ a, ∑ b, P a b * t b = t a)
    (h_connected : ∀ i j,
      PFReachable (fun a b => 0 < P a b) i j) :
    ∀ i j, t i = t j := by
  classical
  obtain ⟨i₀, hi₀, h_i₀_max⟩ :=
    Finset.exists_max_image (Finset.univ : Finset ι) t Finset.univ_nonempty
  have h_max : ∀ j, t j ≤ t i₀ := by
    intro j
    exact h_i₀_max j (Finset.mem_univ j)
  have h_constant : ∀ j, t j = t i₀ :=
    harmonic_ratio_constant_on_pf_reachable
      P t i₀ hP_nonneg hP_sum h_harmonic h_max
      (fun j => h_connected i₀ j)
  intro i j
  exact (h_constant i).trans (h_constant j).symm

end ConstantLlapoy.PaperA

namespace ConstantLlapoy.PaperA

/-- Normalize a nonnegative matrix by a strictly positive right eigenvector.
The resulting transition kernel is stochastic. This is the algebraic bridge
from a positive Perron eigenvector to the harmonic-ratio uniqueness argument. -/
theorem perron_transition_kernel_of_positive_eigenvector
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (A : ι → ι → ℝ) (v : ι → ℝ) (lambdaVal : ℝ)
    (hA_nonneg : ∀ i j, 0 ≤ A i j)
    (hv : ∀ i, 0 < v i)
    (hlambdaVal : 0 < lambdaVal)
    (hAv : ∀ i, ∑ j, A i j * v j = lambdaVal * v i) :
    let P : ι → ι → ℝ :=
      fun i j => (A i j * v j) / (lambdaVal * v i)
    (∀ i j, 0 ≤ P i j) ∧
    (∀ i, ∑ j, P i j = 1) := by
  dsimp
  constructor
  · intro i j
    apply div_nonneg
    · exact mul_nonneg (hA_nonneg i j) (le_of_lt (hv j))
    · exact le_of_lt (mul_pos hlambdaVal (hv i))
  · intro i
    have hden : 0 < lambdaVal * v i := mul_pos hlambdaVal (hv i)
    calc
      ∑ j, (A i j * v j) / (lambdaVal * v i)
          = (∑ j, A i j * v j) / (lambdaVal * v i) := by
              rw [Finset.sum_div]
      _ = 1 := by
          rw [hAv i]
          exact div_self (ne_of_gt hden)


/-- With the same normalization, any other eigenvector for the same positive
eigenvalue gives a harmonic coordinate ratio. Combined with irreducibility,
the finite harmonic-constancy theorem forces this ratio to be constant. -/
theorem perron_eigenvector_ratio_is_harmonic
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (A : ι → ι → ℝ) (v y : ι → ℝ) (lambdaVal : ℝ)
    (hv : ∀ i, 0 < v i)
    (hlambdaVal : 0 < lambdaVal)
    (hAv : ∀ i, ∑ j, A i j * v j = lambdaVal * v i)
    (hAy : ∀ i, ∑ j, A i j * y j = lambdaVal * y i) :
    let P : ι → ι → ℝ :=
      fun i j => (A i j * v j) / (lambdaVal * v i)
    let t : ι → ℝ := fun i => y i / v i
    ∀ i, ∑ j, P i j * t j = t i := by
  dsimp
  intro i
  have hden : lambdaVal * v i ≠ 0 := ne_of_gt (mul_pos hlambdaVal (hv i))
  have hv_ne : ∀ j, v j ≠ 0 := fun j => ne_of_gt (hv j)
  have hterm : ∀ j,
      ((A i j * v j) / (lambdaVal * v i)) * (y j / v j) =
        (A i j * y j) / (lambdaVal * v i) := by
    intro j
    field_simp [hv_ne j, hden]
  calc
    ∑ j, ((A i j * v j) / (lambdaVal * v i)) * (y j / v j)
        = ∑ j, (A i j * y j) / (lambdaVal * v i) := by
            apply Finset.sum_congr rfl
            intro j hj
            exact hterm j
    _ = (∑ j, A i j * y j) / (lambdaVal * v i) := by
          rw [Finset.sum_div]
    _ = y i / v i := by
          rw [hAy i]
          field_simp


end ConstantLlapoy.PaperA


namespace ConstantLlapoy.PaperA

/-- The Doob-normalized Perron transition kernel has exactly the same
positive-edge support as the original nonnegative matrix. Positivity of the
eigenvector coordinates and eigenvalue is essential here. -/
theorem perron_transition_positive_iff
    {ι : Type*}
    (A : ι → ι → ℝ) (v : ι → ℝ) (lambdaVal : ℝ)
    (hv : ∀ i, 0 < v i)
    (hlambdaVal : 0 < lambdaVal)
    (i j : ι) :
    0 < (A i j * v j) / (lambdaVal * v i) ↔ 0 < A i j := by
  have hden : 0 < lambdaVal * v i := mul_pos hlambdaVal (hv i)
  constructor
  · intro h
    have hnum : 0 < A i j * v j :=
      (div_pos_iff_of_pos_right hden).mp h
    exact (mul_pos_iff_of_pos_right (hv j)).mp hnum
  · intro h
    exact div_pos (mul_pos h (hv j)) hden

/-- Positive-edge paths in the matrix support transfer unchanged to the
Perron transition kernel. Thus irreducibility/connectivity is not lost by
the eigenvector normalization. -/
theorem perron_transition_support_connected
    {ι : Type*}
    (A : ι → ι → ℝ) (v : ι → ℝ) (lambdaVal : ℝ)
    (hv : ∀ i, 0 < v i)
    (hlambdaVal : 0 < lambdaVal)
    (hconnected : ∀ i j,
      PFReachable (fun a b => 0 < A a b) i j) :
    ∀ i j, PFReachable
      (fun a b => 0 < (A a b * v b) / (lambdaVal * v a)) i j := by
  intro i j
  induction hconnected i j with
  | refl a =>
      exact PFReachable.refl a
  | step hab htail ih =>
      exact PFReachable.step
        ((perron_transition_positive_iff A v lambdaVal hv hlambdaVal _ _).2 hab)
        ih

end ConstantLlapoy.PaperA


namespace ConstantLlapoy.PaperA

/-- Any two eigenvectors for the same strictly positive eigenvalue are
proportional when the nonnegative matrix has connected positive support and
one eigenvector is strictly positive. The proof passes through the stochastic
Perron normalization and finite harmonic-function constancy. -/
theorem perron_eigenvector_ratios_constant_of_connected
    {ι : Type*} [Fintype ι] [DecidableEq ι] [Nonempty ι]
    (A : ι → ι → ℝ) (v y : ι → ℝ) (lambdaVal : ℝ)
    (hA_nonneg : ∀ i j, 0 ≤ A i j)
    (hv : ∀ i, 0 < v i)
    (hlambdaVal : 0 < lambdaVal)
    (hAv : ∀ i, ∑ j, A i j * v j = lambdaVal * v i)
    (hAy : ∀ i, ∑ j, A i j * y j = lambdaVal * y i)
    (hconnected : ∀ i j,
      PFReachable (fun a b => 0 < A a b) i j) :
    ∀ i j, y i / v i = y j / v j := by
  let P : ι → ι → ℝ :=
    fun i j => (A i j * v j) / (lambdaVal * v i)
  let t : ι → ℝ := fun i => y i / v i
  have hkernel := perron_transition_kernel_of_positive_eigenvector
    A v lambdaVal hA_nonneg hv hlambdaVal hAv
  have hharmonic := perron_eigenvector_ratio_is_harmonic
    A v y lambdaVal hv hlambdaVal hAv hAy
  have hP_connected := perron_transition_support_connected
    A v lambdaVal hv hlambdaVal hconnected
  exact harmonic_function_constant_of_pf_connected
    P t hkernel.1 hkernel.2 hharmonic hP_connected

end ConstantLlapoy.PaperA


namespace ConstantLlapoy.PaperA

/-- Connectedness and a strictly positive eigenvector force every real
eigenvector for the same positive eigenvalue to be a scalar multiple of it.
This is the explicit one-dimensional-eigenspace statement (geometric
simplicity); algebraic simplicity still requires the symmetric spectral
theorem bridge. -/
theorem perron_eigenvector_proportional_of_connected
    {ι : Type*} [Fintype ι] [DecidableEq ι] [Nonempty ι]
    (A : ι → ι → ℝ) (v y : ι → ℝ) (lambdaVal : ℝ)
    (hA_nonneg : ∀ i j, 0 ≤ A i j)
    (hv : ∀ i, 0 < v i)
    (hlambdaVal : 0 < lambdaVal)
    (hAv : ∀ i, ∑ j, A i j * v j = lambdaVal * v i)
    (hAy : ∀ i, ∑ j, A i j * y j = lambdaVal * y i)
    (hconnected : ∀ i j,
      PFReachable (fun a b => 0 < A a b) i j) :
    ∃ c : ℝ, ∀ i, y i = c * v i := by
  obtain ⟨i₀⟩ := ‹Nonempty ι›
  have hratio := perron_eigenvector_ratios_constant_of_connected
    A v y lambdaVal hA_nonneg hv hlambdaVal hAv hAy hconnected
  refine ⟨y i₀ / v i₀, ?_⟩
  intro i
  have h := hratio i i₀
  have hv0 : v i₀ ≠ 0 := ne_of_gt (hv i₀)
  have hvi : v i ≠ 0 := ne_of_gt (hv i)
  field_simp at h ⊢
  nlinarith

end ConstantLlapoy.PaperA


namespace ConstantLlapoy.PaperA

/-- A vector proportional to a strictly positive vector cannot be both
nonzero and orthogonal to it. This is the orthogonality contradiction needed
when the real symmetric spectral theorem supplies an orthonormal eigenbasis:
two basis vectors belonging to the same eigenvalue would contradict the
one-dimensional Perron eigenspace result. -/
theorem proportional_vector_orthogonal_to_positive_is_zero
    {ι : Type*} [Fintype ι] [Nonempty ι]
    (v y : ι → ℝ)
    (hv : ∀ i, 0 < v i)
    (horth : ∑ i, v i * y i = 0)
    (hprop : ∃ c : ℝ, ∀ i, y i = c * v i) :
    ∀ i, y i = 0 := by
  classical
  obtain ⟨c, hc⟩ := hprop
  have hsum_pos : 0 < ∑ i, v i * v i := by
    apply Finset.sum_pos
    · intro i hi
      exact mul_pos (hv i) (hv i)
    · exact Finset.univ_nonempty
  have hfactor : ∑ i, v i * y i = c * (∑ i, v i * v i) := by
    calc
      ∑ i, v i * y i = ∑ i, v i * (c * v i) := by
        apply Finset.sum_congr rfl
        intro i hi
        rw [hc i]
      _ = c * (∑ i, v i * v i) := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro i hi
        ring
  rw [horth] at hfactor
  have hc_zero : c = 0 :=
    (mul_eq_zero.mp hfactor.symm).resolve_right (ne_of_gt hsum_pos)
  intro i
  rw [hc i, hc_zero]
  simp

end ConstantLlapoy.PaperA


namespace ConstantLlapoy.PaperA

/-- Two nonzero vectors that are both proportional to the same strictly
positive vector cannot be orthogonal. This isolates the contradiction needed
to show that an orthonormal eigenbasis contains at most one vector for the
Perron eigenvalue. -/
theorem nonzero_proportional_vectors_not_orthogonal
    {ι : Type*} [Fintype ι] [Nonempty ι]
    (v y z : ι → ℝ)
    (hv : ∀ i, 0 < v i)
    (hy_nonzero : ∃ i, y i ≠ 0)
    (hz_nonzero : ∃ i, z i ≠ 0)
    (hprop_y : ∃ c : ℝ, ∀ i, y i = c * v i)
    (hprop_z : ∃ d : ℝ, ∀ i, z i = d * v i)
    (horth : ∑ i, y i * z i = 0) :
    False := by
  classical
  obtain ⟨c, hcy⟩ := hprop_y
  obtain ⟨d, hdz⟩ := hprop_z
  have hc_ne : c ≠ 0 := by
    intro hc
    obtain ⟨i, hi⟩ := hy_nonzero
    apply hi
    rw [hcy i, hc]
    simp
  have horth_v : ∑ i, v i * z i = 0 := by
    have hmul : c * (∑ i, v i * z i) = 0 := by
      calc
        c * (∑ i, v i * z i)
            = ∑ i, c * (v i * z i) := by
                rw [Finset.mul_sum]
        _ = ∑ i, (c * v i) * z i := by
              apply Finset.sum_congr rfl
              intro i hi
              ring
        _ = ∑ i, y i * z i := by
              apply Finset.sum_congr rfl
              intro i hi
              rw [hcy i]
        _ = 0 := horth
    exact (mul_eq_zero.mp hmul).resolve_left hc_ne
  have hz_zero := proportional_vector_orthogonal_to_positive_is_zero
    v z hv horth_v ⟨d, hdz⟩
  obtain ⟨i, hi⟩ := hz_nonzero
  exact hi (hz_zero i)

end ConstantLlapoy.PaperA


namespace ConstantLlapoy.PaperA

/-- An orthogonal family of nonzero eigenvectors for a fixed positive
eigenvalue of a nonnegative matrix with connected positive support has at
most one member, provided the matrix has a strictly positive eigenvector
for that eigenvalue. This is the finite-dimensional eigenspace-to-multiplicity
bridge needed before instantiating the Hermitian spectral theorem. -/
theorem at_most_one_orthogonal_perron_eigenvector
    {κ ι : Type*} [Fintype κ] [DecidableEq κ] [Nonempty κ]
    [Fintype ι] [DecidableEq ι]
    (A : κ → κ → ℝ) (v : κ → ℝ) (w : ι → κ → ℝ)
    (lambdaVal : ℝ)
    (hA_nonneg : ∀ k l, 0 ≤ A k l)
    (hv : ∀ k, 0 < v k)
    (hlambdaVal : 0 < lambdaVal)
    (hAv : ∀ k, ∑ l, A k l * v l = lambdaVal * v k)
    (hconnected : ∀ k l,
      PFReachable (fun a b => 0 < A a b) k l)
    (hw_nonzero : ∀ i : ι, ∃ k, w i k ≠ 0)
    (hw_eigen : ∀ i : ι, ∀ k : κ, ∑ l, A k l * w i l = lambdaVal * w i k)
    (hw_orthogonal : ∀ i j : ι, i ≠ j →
      ∑ k, w i k * w j k = 0) :
    ∀ i j : ι, i ≠ j → False := by
  intro i j hij
  have hprop_i := perron_eigenvector_proportional_of_connected
    A v (w i) lambdaVal hA_nonneg hv hlambdaVal hAv
    (hw_eigen i) hconnected
  have hprop_j := perron_eigenvector_proportional_of_connected
    A v (w j) lambdaVal hA_nonneg hv hlambdaVal hAv
    (hw_eigen j) hconnected
  exact nonzero_proportional_vectors_not_orthogonal
    v (w i) (w j) hv (hw_nonzero i) (hw_nonzero j)
    hprop_i hprop_j (hw_orthogonal i j hij)

end ConstantLlapoy.PaperA

namespace ConstantLlapoy.PaperA

/-- In an orthogonal eigenbasis indexed by the matrix coordinates, a fixed
positive Perron eigenvalue can occur at most once.  The eigenvector equations
are supplied for every basis vector; the subtype of indices carrying the
Perron eigenvalue inherits the nonzero and orthogonality obligations.  This
is the direct bridge from the one-dimensional Perron eigenspace theorem to
the eigenvalue list in the finite-dimensional symmetric spectral theorem. -/
theorem perron_eigenvalue_occurs_at_most_once_in_orthogonal_eigenbasis
    {κ : Type*} [Fintype κ] [DecidableEq κ] [Nonempty κ]
    (A : κ → κ → ℝ) (v : κ → ℝ)
    (eigenvalue : κ → ℝ) (basisVector : κ → κ → ℝ)
    (lambdaVal : ℝ)
    (hA_nonneg : ∀ k l, 0 ≤ A k l)
    (hv : ∀ k, 0 < v k)
    (hlambdaVal : 0 < lambdaVal)
    (hAv : ∀ k, ∑ l, A k l * v l = lambdaVal * v k)
    (hconnected : ∀ k l,
      PFReachable (fun a b => 0 < A a b) k l)
    (hbasis_nonzero : ∀ i, ∃ k, basisVector i k ≠ 0)
    (hbasis_eigen : ∀ i k,
      ∑ l, A k l * basisVector i l = eigenvalue i * basisVector i k)
    (hbasis_orthogonal : ∀ i j, i ≠ j →
      ∑ k, basisVector i k * basisVector j k = 0) :
    ∀ i j, eigenvalue i = lambdaVal → eigenvalue j = lambdaVal →
      i ≠ j → False := by
  classical
  let I := {i : κ // eigenvalue i = lambdaVal}
  let w : I → κ → ℝ := fun i => basisVector i.1
  have hnonzero : ∀ i : I, ∃ k, w i k ≠ 0 := by
    intro i
    exact hbasis_nonzero i.1
  have heigen : ∀ i : I, ∀ k : κ,
      ∑ l, A k l * w i l = lambdaVal * w i k := by
    intro i k
    rw [hbasis_eigen i.1 k, i.2]
  have horthogonal : ∀ i j : I, i ≠ j →
      ∑ k, w i k * w j k = 0 := by
    intro i j hij
    exact hbasis_orthogonal i.1 j.1 (by
      intro h
      apply hij
      exact Subtype.ext h)
  have hunique := at_most_one_orthogonal_perron_eigenvector
    A v w lambdaVal hA_nonneg hv hlambdaVal hAv hconnected
    hnonzero heigen horthogonal
  intro i j hi hj hij
  exact hunique ⟨i, hi⟩ ⟨j, hj⟩ (by
    intro hsub
    apply hij
    exact congrArg Subtype.val hsub)

end ConstantLlapoy.PaperA



namespace ConstantLlapoy.PaperA

/-- Instantiate the orthogonal-eigenbasis multiplicity bound with Mathlib's
actual orthonormal eigenvector basis for a real symmetric matrix. This is
still an at-most-once statement; existence of the Perron eigenvalue in the
spectral list and the characteristic-polynomial multiplicity count are
separate obligations. -/
theorem perron_eigenvalue_occurs_at_most_once_in_real_symmetric_spectrum
    {κ : Type*} [Fintype κ] [DecidableEq κ] [Nonempty κ]
    (A : Matrix κ κ ℝ) (hA : A.IsHermitian)
    (v : κ → ℝ) (lambdaVal : ℝ)
    (hA_nonneg : ∀ i j, 0 ≤ A i j)
    (hv : ∀ i, 0 < v i)
    (hlambdaVal : 0 < lambdaVal)
    (hAv : ∀ i, ∑ j, A i j * v j = lambdaVal * v i)
    (hconnected : ∀ i j,
      PFReachable (fun a b => 0 < A a b) i j) :
    ∀ i j, hA.eigenvalues i = lambdaVal →
      hA.eigenvalues j = lambdaVal → i ≠ j → False := by
  let eigenvalue : κ → ℝ := hA.eigenvalues
  let basisVector : κ → κ → ℝ :=
    fun i k => ⇑(hA.eigenvectorBasis i) k
  have hbasis_nonzero : ∀ i, ∃ k, basisVector i k ≠ 0 := by
    intro i
    have hnorm : ‖hA.eigenvectorBasis i‖ = 1 :=
      hA.eigenvectorBasis.orthonormal.1 i
    by_contra h
    push_neg at h
    have hzero' : hA.eigenvectorBasis i = 0 := by
      ext k
      exact h k
    have hnorm_zero := congrArg norm hzero'
    rw [norm_zero] at hnorm_zero
    linarith
  have hbasis_eigen : ∀ i k,
      ∑ l, A k l * basisVector i l =
        eigenvalue i * basisVector i k := by
    intro i k
    have hmul := congrFun (hA.mulVec_eigenvectorBasis i) k
    simpa [basisVector, eigenvalue, Matrix.mulVec, dotProduct] using hmul
  have hbasis_orthogonal : ∀ i j, i ≠ j →
      ∑ k, basisVector i k * basisVector j k = 0 := by
    intro i j hij
    have hinner :=
      (orthonormal_iff_ite.mp hA.eigenvectorBasis.orthonormal) j i
    have hinner_zero :
        inner ℝ (hA.eigenvectorBasis j) (hA.eigenvectorBasis i) = 0 := by
      simpa [Ne.symm hij] using hinner
    have hdot :
        dotProduct ((hA.eigenvectorBasis i).ofLp)
          ((hA.eigenvectorBasis j).ofLp) = 0 := by
      simpa [EuclideanSpace.inner_eq_star_dotProduct, star_trivial] using
        hinner_zero
    simpa [basisVector, dotProduct] using hdot
  exact perron_eigenvalue_occurs_at_most_once_in_orthogonal_eigenbasis
    A v eigenvalue basisVector lambdaVal hA_nonneg hv hlambdaVal hAv
    hconnected hbasis_nonzero hbasis_eigen hbasis_orthogonal

end ConstantLlapoy.PaperA


namespace ConstantLlapoy.PaperA

/-- A supplied nonzero eigenvector places its eigenvalue in the real
spectrum. The matrix/linear-map algebra equivalence transfers spectrum
membership back to the matrix, and the Hermitian spectral theorem identifies
that value with an entry of the indexed eigenvalue list. -/
theorem perron_eigenvalue_occurs_in_real_symmetric_spectrum
    {κ : Type*} [Fintype κ] [DecidableEq κ] [Nonempty κ]
    (A : Matrix κ κ ℝ) (hA : A.IsHermitian)
    (v : κ → ℝ) (lambdaVal : ℝ)
    (hv : ∀ i, 0 < v i)
    (hAv : ∀ i, ∑ j, A i j * v j = lambdaVal * v i) :
    ∃ i, hA.eigenvalues i = lambdaVal := by
  obtain ⟨i₀⟩ := ‹Nonempty κ›
  have hv_ne : v ≠ 0 := by
    intro hz
    have hpos := hv i₀
    rw [hz] at hpos
    norm_num at hpos
  have hlin : A.toLin' v = lambdaVal • v := by
    ext i
    simpa [Matrix.toLin'_apply, Matrix.mulVec, dotProduct] using hAv i
  have heig : Module.End.HasEigenvector (A.toLin') lambdaVal v := by
    rw [Module.End.hasEigenvector_iff, Module.End.mem_eigenspace_iff]
    exact ⟨hlin, hv_ne⟩
  have hspec_lin : lambdaVal ∈ spectrum ℝ A.toLin' :=
    (Module.End.hasEigenvalue_of_hasEigenvector heig).mem_spectrum
  have hspec_eq : spectrum ℝ A.toLin' = spectrum ℝ A := by
    exact AlgEquiv.spectrum_eq
      (Matrix.toLinAlgEquiv (Pi.basisFun ℝ κ)) A
  have hspec : lambdaVal ∈ spectrum ℝ A := hspec_eq ▸ hspec_lin
  rw [hA.spectrum_real_eq_range_eigenvalues] at hspec
  exact Set.mem_range.mp hspec

end ConstantLlapoy.PaperA


namespace ConstantLlapoy.PaperA

/-- A strictly positive eigenvector of a real symmetric matrix with
nonnegative entries and connected positive support identifies an eigenvalue
that occurs at exactly one index in Mathlib's orthonormal spectral list.
Existence comes from the supplied eigenvector; uniqueness comes from the
one-dimensional Perron eigenspace and orthogonality of the spectral basis.
This is an exact list-level multiplicity statement, not yet the
characteristic-polynomial root-multiplicity theorem. -/
theorem perron_eigenvalue_occurs_exactly_once_in_real_symmetric_spectrum
    {κ : Type*} [Fintype κ] [DecidableEq κ] [Nonempty κ]
    (A : Matrix κ κ ℝ) (hA : A.IsHermitian)
    (v : κ → ℝ) (lambdaVal : ℝ)
    (hA_nonneg : ∀ i j, 0 ≤ A i j)
    (hv : ∀ i, 0 < v i)
    (hlambdaVal : 0 < lambdaVal)
    (hAv : ∀ i, ∑ j, A i j * v j = lambdaVal * v i)
    (hconnected : ∀ i j,
      PFReachable (fun a b => 0 < A a b) i j) :
    ∃! i, hA.eigenvalues i = lambdaVal := by
  obtain ⟨i₀, hi₀⟩ :=
    perron_eigenvalue_occurs_in_real_symmetric_spectrum A hA v lambdaVal hv hAv
  refine ⟨i₀, hi₀, ?_⟩
  intro j hj
  by_contra hne
  have hne' : i₀ ≠ j := by
    intro h
    exact hne h.symm
  exact perron_eigenvalue_occurs_at_most_once_in_real_symmetric_spectrum
    A hA v lambdaVal hA_nonneg hv hlambdaVal hAv hconnected
    i₀ j hi₀ hj hne'

end ConstantLlapoy.PaperA


namespace ConstantLlapoy.PaperA

/-- For a real symmetric matrix, the characteristic-polynomial root
multiplicity at a supplied positive Perron eigenvalue is exactly one.
The proof uses Mathlib's exact multiset identity between characteristic
roots and the real-spectral eigenvalue list, then counts the unique index.
This is the algebraic-simplicity conclusion, not merely list-index
uniqueness. -/
theorem perron_eigenvalue_has_characteristic_root_multiplicity_one
    {κ : Type*} [Fintype κ] [DecidableEq κ] [Nonempty κ]
    (A : Matrix κ κ ℝ) (hA : A.IsHermitian)
    (v : κ → ℝ) (lambdaVal : ℝ)
    (hA_nonneg : ∀ i j, 0 ≤ A i j)
    (hv : ∀ i, 0 < v i)
    (hlambdaVal : 0 < lambdaVal)
    (hAv : ∀ i, ∑ j, A i j * v j = lambdaVal * v i)
    (hconnected : ∀ i j,
      PFReachable (fun a b => 0 < A a b) i j) :
    Polynomial.rootMultiplicity (RCLike.ofReal lambdaVal) A.charpoly = 1 := by
  classical
  obtain ⟨i₀, hi₀, hunique⟩ :=
    perron_eigenvalue_occurs_exactly_once_in_real_symmetric_spectrum
      A hA v lambdaVal hA_nonneg hv hlambdaVal hAv hconnected
  have hindex_card :
      (Finset.univ.filter
        (fun i : κ => hA.eigenvalues i = lambdaVal)).card = 1 := by
    apply Finset.card_eq_one.mpr
    refine ⟨i₀, ?_⟩
    ext i
    simp only [Finset.mem_filter, Finset.mem_univ, true_and,
      Finset.mem_singleton]
    constructor
    · intro hi
      exact hunique i hi
    · intro hi
      subst i
      exact hi₀
  have hfiltered_card :
      (Finset.univ.val.filter
        (fun i : κ =>
          RCLike.ofReal lambdaVal =
            ((RCLike.ofReal : ℝ → RCLike ℝ) ∘ hA.eigenvalues) i)).card = 1 := by
    have hfilter_eq :
        Finset.univ.filter
          (fun i : κ =>
            RCLike.ofReal lambdaVal =
              ((RCLike.ofReal : ℝ → RCLike ℝ) ∘ hA.eigenvalues) i) =
        Finset.univ.filter
          (fun i : κ => hA.eigenvalues i = lambdaVal) := by
      ext i
      simp only [Finset.mem_filter, Finset.mem_univ, true_and,
        Function.comp_apply]
      constructor
      · intro hi
        exact (RCLike.ofReal_injective hi).symm
      · intro hi
        rw [hi]
    rw [← Finset.filter_val, hfilter_eq]
    simpa only [Finset.card] using hindex_card
  rw [← Polynomial.count_roots, hA.roots_charpoly_eq_eigenvalues,
    Multiset.count_map]
  simpa using hfiltered_card

end ConstantLlapoy.PaperA
